{
  "manifest_version": 3,
  "name": "Calculadora MP V2 - Turnos",
  "version": "2.0",
  "description": "Suma los cobros de Mercado Pago por turno (versión 2: más rápida, montos exactos al centavo)",
  "permissions": ["scripting", "tabs"],
  "host_permissions": ["https://www.mercadopago.com.ar/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png" }
  },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
}
